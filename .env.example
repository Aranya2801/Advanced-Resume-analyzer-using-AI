# Copy to .env. Everything here is optional - the analyzer works without any of it.

# Which sentence encoder to use for semantic matching: auto | sbert | spacy | none
RESUME_ANALYZER_ENCODER=auto
# RESUME_ANALYZER_SBERT_MODEL=all-MiniLM-L6-v2

# LLM feedback (bullet rewrites, written review, cover letters)
# LLM_PROVIDER=anthropic          # or openai
# LLM_MODEL=                      # leave empty for the default
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. a local Ollama server

# API
MAX_FILE_SIZE_MB=5
CORS_ORIGINS=http://localhost:8501
